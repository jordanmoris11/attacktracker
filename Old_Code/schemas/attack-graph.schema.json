{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Attack Graph",
  "description": "A representation of a cybersecurity attack flow for visualization.",
  "type": "object",
  "required": ["title", "nodes", "edges"],
  "properties": {
    "title": {
      "type": "string",
      "description": "The name of the attack scenario."
    },
    "description": {
      "type": "string",
      "description": "A brief summary of the attack."
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the node."
          },
          "label": {
            "type": "string",
            "description": "Display label for the node."
          },
          "type": {
            "type": "string",
            "enum": ["container", "process", "file", "service", "network_node", "credential", "memory"],
            "default": "network_node"
          },
          "parent": {
            "type": "string",
            "description": "The ID of the parent container node."
          },
          "icon": {
            "type": "string",
            "description": "Explicit icon identifier (e.g., 'windows', 'attacker')."
          },
          "state": {
            "type": "string",
            "enum": ["normal", "compromised", "elevated", "protected"],
            "default": "normal"
          },
          "properties": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "label"],
        "properties": {
          "source": {
            "type": "string",
            "description": "ID of the source node."
          },
          "target": {
            "type": "string",
            "description": "ID of the target node."
          },
          "label": {
            "type": "string",
            "description": "Label describing the action."
          },
          "mitre": {
            "type": "string",
            "description": "MITRE ATT&CK T-Code (e.g., T1003.001)."
          },
          "type": {
            "type": "string",
            "enum": ["normal", "illegal", "impact"],
            "default": "normal"
          }
        }
      }
    }
  }
}
