{
  "title": "Shai Hulud 2.0 Supply Chain Attack",
  "description": "An advanced npm supply chain attack that utilizes malicious preinstall scripts to harvest sensitive credentials and exfiltrates them to an attacker-controlled GitHub repository acting as C2.",
  "version": "3.0",
  "viewport": {
    "zoom": 1.5795838514178628,
    "pan": {
      "x": 177.87306406959638,
