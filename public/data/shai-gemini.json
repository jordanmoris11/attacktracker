{
  "title": "Shai-Hulud 2.0 NPM Supply Chain Worm",
  "description": "A sophisticated self-propagating worm targeting the npm ecosystem using 'Bring Your Own Runtime' evasion via Bun and GitHub-based exfiltration.",
